# Read by docker-compose.yml. Copy to .env and fill in real values.
# Every `change-me` value is a placeholder the server refuses to start with.

# Ends up in DATABASE_URL: URL-safe characters only (`openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me

# Signs sessions and Docker registry tokens. 32 random bytes at least (`openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts stored secrets (SMTP, LDAP, OIDC, proxy credentials, TOTP seeds). Mandatory, random, and different from
# JWT_SECRET so that a leaked JWT_SECRET does not also decrypt them. To change it later, see "Upgrades and encryption
# key rotation" in the README.
SECRETS_ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# Only while rotating SECRETS_ENCRYPTION_KEY: the key the stored secrets use today.
# SECRETS_ENCRYPTION_KEY_PREVIOUS=

# `true` rewrites stored secrets in the current format, or under the new key after a rotation. Leave it unset until an
# upgrade is verified: earlier releases cannot read the rewritten values.
# SECRETS_REENCRYPT_LEGACY=true

# The URL clients reach this deployment at, scheme included. Mandatory. It must not point at 0.0.0.0.
PUBLIC_URL=https://app.artiferris.example.com

# Base domain of organizations: "artiferris.example" resolves "acme.artiferris.example" to the "acme" organization.
# Mandatory.
ARTIFERRIS_BASE_DOMAIN=artiferris.example.com

# Creates an account only when the users table is empty, so it is safe to leave set. Without it there is no way to
# create a first admin. The password needs 8 characters at least, or it fails silently (logged) and leaves no admin.
ARTIFERRIS_BOOTSTRAP_ADMIN_USERNAME=admin
ARTIFERRIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Private ranges (comma-separated CIDRs or addresses) that LDAP, SMTP, OIDC and proxy hosts may resolve to. Private
# addresses are refused by default; list only what you need. Unencrypted SMTP is accepted only for these hosts. A typo
# or a /0 range stops the server.
# ARTIFERRIS_SSRF_ALLOWED_CIDRS=10.20.0.0/16

# Behind a reverse proxy, set the addresses or ranges it connects from (comma-separated, every hop). Only they get
# their X-Forwarded-For believed. Left empty, every client shares one sign-in throttle bucket. A /0 range is refused.
# TRUSTED_PROXY_IPS=10.0.0.4,10.0.0.5

# Days audit events are kept (default 365, 0 keeps everything, 36500 at most). Package, repository and permission events
# are never deleted.
# AUDIT_RETENTION_DAYS=365

# Restricts CORS to one origin (scheme and host, no trailing slash). Unset, only localhost origins are allowed.
# CORS_ALLOWED_ORIGIN=https://artiferris.example.com

# Leave unset: the Docker token realm is derived from each request. Set it only behind something that does not forward
# Host and the scheme; it then pins every client to one realm. https:// outside localhost.
# ARTIFERRIS_DOCKER_TOKEN_REALM=https://artiferris.example.com/v2/token
