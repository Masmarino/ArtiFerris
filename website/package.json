{
  "name": "artiferris-website",
  "version": "0.0.0",
  "private": true,
  "description": "Prerendered showcase site of ArtiFerris (www.artiferris.pro).",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "images": "node scripts/build-images.mjs",
    "plan": "node scripts/build-plan.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "prestart": "npm run sitemap",
    "prebuild": "npm run sitemap",
    "postbuild": "node scripts/finalize-dist.mjs && npm run check:dist"
  },
  "engines": {
    "node": "^26.10.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@masmarino/gabarit": "^1.2.2",
    "highlight.js": "^11.12.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@types/node": "^26.6.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.7",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  }
}
