  "query": "SELECT t.image_name AS \"image_name!\", t.tag AS \"tag!\" FROM unnest($2::text[]) AS i(name) CROSS JOIN LATERAL (SELECT image_name, tag, updated_at FROM docker_tags WHERE package_repository_id = $1 AND image_name = i.name ORDER BY updated_at DESC, tag LIMIT $3) t ORDER BY t.image_name, t.updated_at DESC, t.tag",
