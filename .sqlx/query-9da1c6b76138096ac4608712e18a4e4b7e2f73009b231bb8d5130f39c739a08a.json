  "query": "SELECT DISTINCT ON (m.digest) m.digest, m.body FROM docker_tags t JOIN docker_manifests m ON m.id = t.manifest_id WHERE t.package_repository_id = $1 AND t.image_name = $2 AND m.digest = ANY($3) AND octet_length(m.body)::bigint <= $4 ORDER BY m.digest",
